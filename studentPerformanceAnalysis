print("\nClassification Report:")
print(classification_report(y_test_cls, preds))


# 5-fold cross-validation on the Random Forest Regressor
cv_scores = cross_val_score(rf, X, y_reg, cv=5, scoring='r2')

print("\nCross‑validated R² scores:", cv_scores)
print("Mean CV R²:", cv_scores.mean())


#model comparison tabel
results = pd.DataFrame({

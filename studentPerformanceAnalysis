#80% training 20% testing stratified so pass/fail ratio stays balanced

# One-hot encode 
df = pd.get_dummies(df, columns=['sex', 'address', 'famsize', 'Pstatus'], drop_first=True)

# features (drop midterm grades + final grade + pass label)
X = df.drop(columns=["G1", "G2", "G3", "pass"])

# regression target
y_reg = df["G3"]

# classification target
y_clf = df["pass"]

# split
X_train, X_test, yreg_train, yreg_test, yclf_train, yclf_test = train_test_split(
    X, y_reg, y_clf,
    test_size=0.2,
    random_state=42,
    stratify=y_clf
)

print("Training samples:", X_train.shape[0])
print("Testing samples:", X_test.shape[0])


#Linear regression

#create and train model on data
lr = LinearRegression()
lr.fit(X_train, yreg_train)

#predict g3
pred_lr = lr.predict(X_test)

#evaluate performance
mse_lr = mean_squared_error(yreg_test, pred_lr)
rmse_lr = np.sqrt(mse_lr)
r2_lr = r2_score(yreg_test, pred_lr)

print("Linear Regression:")
print("  MSE:", mse_lr)
print("  RMSE:", rmse_lr)
print("  R²:", r2_lr)


#Decision Tree Regressor

#prevent overfitting
dt = DecisionTreeRegressor(max_depth=5, min_samples_split=10, random_state=42)
#train
dt.fit(X_train, yreg_train)

#predict
pred_dt = dt.predict(X_test)

#evaluate
mse_dt = mean_squared_error(yreg_test, pred_dt)
rmse_dt = np.sqrt(mse_dt)
r2_dt = r2_score(yreg_test, pred_dt)

print("\nDecision Tree Regressor:")
print("  MSE:", mse_dt)
print("  RMSE:", rmse_dt)
print("  R²:", r2_dt)

#random forest regressor

# Random Forest = many decision trees averaged together
rf = RandomForestRegressor(
    n_estimators=100,      # number of trees
    max_depth=8,           # limit depth to avoid overfitting
    min_samples_split=5,   # minimum samples to split a node
    random_state=42
)

#train
rf.fit(X_train, yreg_train)

#predict
pred_rf = rf.predict(X_test)

#evaluate
mse_rf = mean_squared_error(yreg_test, pred_rf)
rmse_rf = np.sqrt(mse_rf)
r2_rf = r2_score(yreg_test, pred_rf)

#print decision tree
from sklearn.tree import plot_tree

plt.figure(figsize=(25,12))
plot_tree(
    dt,
    feature_names=X.columns,
    filled=True,
    max_depth=3,
    impurity=False,
    proportion=False,
    precision = 0,
    fontsize = 10,
    rounded=True
)
plt.show()

print("\nRandom Forest Regressor:")
print("  MSE:", mse_rf)
print("  RMSE:", rmse_rf)
print("  R²:", r2_rf)

#creates a bar chart in order of most important features
importances = rf.feature_importances_
indices = np.argsort(importances)[::-1]
features = X_train.columns

plt.figure(figsize=(10, 8))
plt.title("Feature Importance (Random Forest)")
plt.bar(range(len(importances)), importances[indices])
plt.xticks(range(len(importances)), features[indices], rotation=90)
plt.tight_layout()
plt.show()

